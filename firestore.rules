rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 학생 정보: 본인만 읽고 쓸 수 있음 (이메일은 다른 사람에게 절대 안 보임)
    // 학년·반·번호(seat)는 seats 문서의 주인이 나일 때만 저장 가능
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.grade in [1, 2, 3]
        && request.resource.data.classNo is int && request.resource.data.classNo >= 1 && request.resource.data.classNo <= 30
        && request.resource.data.number is int && request.resource.data.number >= 1 && request.resource.data.number <= 60
        && request.resource.data.seat == string(request.resource.data.grade) + '-'
             + string(request.resource.data.classNo) + '-' + string(request.resource.data.number)
        && getAfter(/databases/$(database)/documents/seats/$(request.resource.data.seat)).data.uid == uid;
    }

    // 학년·반·번호 자리: 한 자리에는 한 계정만 (먼저 등록한 사람이 주인)
    match /seats/{seat} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /surveys/{surveyId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0
        && request.resource.data.questions.size() <= 30;

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // 응답: 한 계정당 한 번만 (문서 이름 = 내 uid, 수정 불가)
      // 학년·반·번호를 등록한 학생만 응답 가능
      match /responses/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/users/$(request.auth.uid));
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          get(/databases/$(database)/documents/surveys/$(surveyId)).data.ownerUid == request.auth.uid
        );
      }
    }
  }
}
