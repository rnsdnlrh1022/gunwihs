rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isGoogle() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function hasRole() { return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)); }
    function roleDoc() { return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data; }
    function isMaster() { return hasRole() && roleDoc().role == 'master'; }
    function isTeacher() { return hasRole() && roleDoc().role == 'teacher'; }
    function secrets() { return get(/databases/$(database)/documents/config/secrets).data; }

    // 비밀번호 보관함: 아무도 읽을 수 없음 (규칙만 몰래 확인), 관리자만 변경 가능
    match /config/{doc} {
      allow read: if false;
      allow write: if isMaster() && doc == 'secrets'
        && request.resource.data.teacherPin is string && request.resource.data.teacherPin.size() >= 4
        && request.resource.data.masterPin is string && request.resource.data.masterPin.size() >= 4;
    }

    // 선생님·관리자 역할: 구글 로그인 + 비밀번호가 맞을 때만 만들어짐
    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isMaster());
      allow list: if isMaster();
      allow create: if isGoogle() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && ((request.resource.data.role == 'teacher' && request.resource.data.pin == secrets().teacherPin)
          || (request.resource.data.role == 'master' && request.resource.data.pin == secrets().masterPin));
      allow delete: if signedIn() && (request.auth.uid == uid || isMaster());
    }

    // 학생 정보: 본인과 관리자만 볼 수 있음. 구글 로그인 학생만 등록 가능
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isMaster());
      allow list: if isMaster();
      allow create, update: if isGoogle() && request.auth.uid == uid
        && request.resource.data.grade in [1, 2, 3]
        && request.resource.data.classNo is int && request.resource.data.classNo >= 1 && request.resource.data.classNo <= 30
        && request.resource.data.number is int && request.resource.data.number >= 1 && request.resource.data.number <= 60
        && request.resource.data.seat == string(request.resource.data.grade) + '-'
             + string(request.resource.data.classNo) + '-' + string(request.resource.data.number)
        && getAfter(/databases/$(database)/documents/seats/$(request.resource.data.seat)).data.uid == uid;
      allow delete: if isMaster();
    }

    // 학년·반·번호 자리: 한 자리에 한 계정만
    match /seats/{seat} {
      allow get: if signedIn();
      allow create: if isGoogle() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isMaster());
    }

    match /surveys/{surveyId} {
      // 학생은 승인된 설문(선생님 전용 제외)과 내가 만든 설문만 볼 수 있음. 선생님·master는 전부
      allow read: if signedIn() && ((resource.data.staffOnly == false && resource.data.status == 'approved')
        || resource.data.ownerUid == request.auth.uid || isTeacher() || isMaster());

      // 작성자 표시(학년·반·번호 / 선생님 이름)가 진짜 본인 정보와 같아야 올라감
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0
        && request.resource.data.questions.size() <= 30
        && request.resource.data.grade in [0, 1, 2, 3, 9]
        && request.resource.data.staffOnly == (request.resource.data.grade == 9)
        && request.resource.data.status == (hasRole() ? 'approved' : 'pending')   // 학생 설문은 승인 대기로 시작
        && (request.resource.data.staffOnly == false || isTeacher() || isMaster())
        && ((request.resource.data.ownerRole == 'student'
              && request.resource.data.ownerName is string
              && request.resource.data.ownerName.size() > 0 && request.resource.data.ownerName.size() <= 20
              && exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && request.resource.data.ownerLabel == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.seat)
          || (request.resource.data.ownerRole in ['teacher', 'master']
              && hasRole()
              && request.resource.data.ownerRole == roleDoc().role
              && request.resource.data.ownerLabel == roleDoc().name));

      // 승인·반려: master만, 상태 관련 칸만 바꿀 수 있음
      allow update: if isMaster()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectReason', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected', 'pending'];

      // 삭제: 만든 사람 또는 관리자
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isMaster());

      // 응답: 학번을 등록한 학생(master 포함)과 선생님만, 한 번만. 결과는 만든 사람·선생님·관리자가 볼 수 있음
      match /responses/{uid} {
        allow create: if isGoogle() && request.auth.uid == uid
          && (isTeacher() || exists(/databases/$(database)/documents/users/$(request.auth.uid)))
          && get(/databases/$(database)/documents/surveys/$(surveyId)).data.status == 'approved'
          && (get(/databases/$(database)/documents/surveys/$(surveyId)).data.grade != 9 || isTeacher());
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/surveys/$(surveyId)).data.ownerUid == request.auth.uid
          || isTeacher() || isMaster() || request.auth.uid == uid);
      }
    }
  }
}
